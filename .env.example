# Copy to .env and fill in. Nothing here is committed.

# Postgres (Neon, Supabase, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/printables?schema=public"

# Public URL of the deployed site, used in emails and Stripe redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The one admin account. Sign in with a magic link to this address to reach /admin.
ADMIN_EMAIL="you@example.com"

# Random 32+ byte string for session cookies: `openssl rand -base64 32`
AUTH_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudflare R2 (S3-compatible). Bucket must be private.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="printables"
# Optional: a public custom domain for the bucket, used for images and preview meshes only.
# Leave empty to serve them through signed URLs instead.
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Resend (optional locally: without it, emails are printed to the server log)
RESEND_API_KEY=""
EMAIL_FROM="Store <store@yourdomain.com>"
